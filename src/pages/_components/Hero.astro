---
import { Image } from "astro:assets";
import image from "~/assets/profile-picture.png";
import Section from "~/components/Section";
import { getCollection } from "astro:content";
import { render } from "astro:content";
import { components } from "~/components/mdx";

const filteredExperiences = (await getCollection("experiences")).filter(
  (e) => e.data.featured
);
if (filteredExperiences.length !== 1) {
  throw new Error("Requires 1 featured experience to show in the hero");
}
const featured = filteredExperiences[0];
const { Content } = await render(featured);
---

<Section class="pt-0 sm:pt-8 grid grid-cols-5 gap-4 items-center">
  <div class="flex flex-col gap-6 col-span-2">
    <Image
      src={image}
      alt=""
      class="size-24 sm:size-16 rounded-full bg-bg-subtle border border-border shrink-0"
      loading="eager"
      width={128}
    />
    <div>
      <h2 class="mb-1">Florian Lefebvre</h2>
      <h1 class="text-3xl/7 font-semibold text-text text-balance">
        Astro expert & fullstack developer
      </h1>
      <div class="my-6 space-y-3 sm:space-y-1">
        <p>
          Fullstack developer. Freelancer. Astro core maintainer & TSC member.
        </p>
        <p>
          Open-Source lover. French. Two-time winner of the Astro Community
          Award.
        </p>
      </div>
      <div>
        <span
          id="hero-time"
          class="bg-bg-subtle rounded-full border border-border px-1.5 py-0.5 tabular-nums select-none text-text"
          >00:00:00</span
        > CET
      </div>
    </div>
  </div>
  <div class="col-span-3">
    <h3 class="px-2 text-sm mb-1">Featured project</h3>
    <div class="rounded-2xl bg-bg-subtle border border-border p-2">
      <Image
        src={featured.data.image.src}
        alt={featured.data.image.alt}
        loading="eager"
        decoding="sync"
        class="rounded-[0.5rem] bg-text border border-border"
      />
      <div class="px-1 pt-2">
        <div class="flex items-center justify-between gap-2">
          {
            featured.data.links.length > 0 ? (
              <a
                href={featured.data.links[0].href}
                class="text-primary-contrast underline font-bold text-lg flex items-center"
                target="_blank"
              >
                {featured.data.title}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  class="size-4 ml-1"
                >
                  <path
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
                  />
                </svg>
              </a>
            ) : (
              <div class="text-text font-bold text-lg">
                {featured.data.title}
              </div>
            )
          }

          <div class="text-sm">{featured.data.date}</div>
        </div>
        <div class="text-sm mt-1">
          <Content {components} />
        </div>
      </div>
    </div>
  </div>
</Section>
<script is:inline>
  (() => {
    const updateTime = () => {
      const today = new Date();
      const formatter = new Intl.DateTimeFormat("en-US", {
        timeZone: "CET",
        hour12: false, // 24-hour format
        hour: "numeric",
        minute: "numeric",
        second: "numeric",
      });

      // Format the date using the formatter
      const timeInTimeZone = formatter.format(today);

      document.getElementById("hero-time").innerText = timeInTimeZone;
    };

    updateTime();
    return setInterval(() => {
      updateTime();
    }, 1000);
  })();
</script>
