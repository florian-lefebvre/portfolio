---
import "~/styles/main.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import { SEO } from "astro-seo";
import { Font } from "astro:assets";

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: Required<Parameters<typeof SEO>[0]>["openGraph"]["article"];
}

const {
  title: _title,
  description,
  image: _image = "/og.jpg",
  article,
} = Astro.props;

const title = `${_title} | Florian Lefebvre`;

const canonical = Astro.url.href;
// Open Graph and Twitter require absolute URLs, but Astro image sources are
// emitted as site-relative paths.
const image = new URL(_image, Astro.site ?? Astro.url).href;
---

<html lang="en" dir="ltr" class="h-full">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-inter" preload />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO
      {title}
      {description}
      {canonical}
      openGraph={{
        basic: {
          title,
          type: "website",
          image,
          url: canonical,
        },
        optional: {
          description,
          locale: "en",
        },
        article,
      }}
      twitter={{
        card: "summary_large_image",
        creator: "@LfbvrFlo",
        title,
        image,
        description,
      }}
    />
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          data-domain="florian-lefebvre.dev"
          src="/js/script.js"
        />
      )
    }
    <slot name="head" />
  </head>
  <body class="flex min-h-full flex-col bg-bg text-text-subtle">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-20 focus:m-2 focus:rounded-full focus:border focus:border-border focus:bg-bg focus:px-3 focus:py-1.5 focus:text-text"
    >
      Skip to content
    </a>
    <div class="sticky top-0 left-0 h-2 w-full z-10 bg-bg">
      <div
        id="page-progress"
        class="h-full bg-primary-bg transition-[color,width] linear duration-100"
        style={{ width: "0%" }}
      >
      </div>
    </div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (() => {
        const progressBar = document.getElementById("page-progress");
        let queued = false;

        /**
         *
         * @param {number} min
         * @param {number} n
         * @param {number} max
         */
        const clamp = (min, n, max) => Math.min(max, Math.max(min, n));

        // this function increase or decrease the percentage of the element to stretch
        function stretch() {
          queued = false;

          const scrollable =
            document.documentElement.scrollHeight - window.innerHeight;

          // convert pixels to percentage
          const pixelsToPercentage =
            scrollable > 0 ? clamp(0, (window.scrollY / scrollable) * 100, 100) : 0;

          // set the width of the fluid element.
          progressBar.style.width = Math.round(pixelsToPercentage) + "%";
        }

        // coalesce bursts of events into a single write per frame
        function schedule() {
          if (queued) return;
          queued = true;
          requestAnimationFrame(stretch);
        }

        stretch();
        window.addEventListener("scroll", schedule, { passive: true });
        window.addEventListener("resize", schedule, { passive: true });
      })();
    </script>
  </body>
</html>
